<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net6.0-windows</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>Resources\ApplicationIcon.ico</ApplicationIcon>
		<Authors>RyanDMcAfee</Authors>
		<Product>Valheim BakaLoader</Product>
		<Description>A simple user interface for running Valheim Dedicated Server on Windows.</Description>
		<Copyright>2026</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Version>1.2.8</Version>
    <!-- Build date adapted from: https://rmauro.dev/add-build-time-to-your-csharp-assembly/ -->
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</SourceRevisionId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\SolutionResources\ValheimBakaLoader.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<Target Name="PostPublish" AfterTargets="Publish" Condition="'$(Configuration)'=='Release'">
		<Exec Command="post-publish.bat" />
	</Target>

	<!--
	  THE FROZEN LAUNCHER. The exe is not the program: the SDK generates it for every build,
	  353,280 bytes of generic startup code carrying the name of the assembly to load, and
	  everything BakaLoader does lives in the DLL beside it. Because the version resource is
	  inside those bytes, every release used to ship an exe nobody had ever seen before: 1.2.6
	  and 1.2.7 differ in fourteen bytes, all of them the version strings. On 2026-10-04
	  Defender's local model called the fresh 1.2.7 hash Trojan:Win32/Bearfoos.A!ml on a host's
	  PC and quarantined it, which took the app and the live server down with it.

	  So from 1.2.8 the launcher is a committed artefact, Resources\host\ValheimBakaLoader.exe
	  (the 1.2.6 bytes, which have run everywhere since 2026-09-30 undetected), copied over
	  whatever the SDK just generated. Every release ships the same exe, and the self-update
	  compares hashes and does not write the file at all when they match, so there is no new
	  file for a local model to judge. The app's version is the DLL's, which is where the
	  window, the log and the update check all read it from already; 1.2.8 pins it there rather
	  than moving it.

	  The frozen host is the SDK's generic apphost with three things of its own in it: the
	  assembly name, the target framework it was generated for, and the application icon, which
	  the SDK writes into the apphost's resources rather than into the DLL. All three are checked
	  here rather than assumed. The first two are an app that does not start; the third is
	  quieter and worse, because a new ApplicationIcon.ico would build, pass and ship while every
	  host went on seeing the old picture, the frozen bytes having been generated before it. Any
	  of the three moving must stop the build rather than ship.

	  The copy happens TWICE, and the first one is the one that matters. The SDK writes the
	  apphost it generates into the intermediate folder (obj\...\apphost.exe) and every
	  consumer takes its copy from there: the output folder, a publish, and any project that
	  references this one. Freezing only the output folder left the test project's own copy
	  unfrozen, which is how this was caught, and a release cut with publish rather than build
	  would have shipped the generated exe. So the intermediate copy is replaced the moment it
	  is made, and the output folder is done again after Build because an incremental build can
	  skip the step that copies it there.
	-->
	<PropertyGroup>
		<FrozenAppHost>$(MSBuildProjectDirectory)\Resources\host\ValheimBakaLoader.exe</FrozenAppHost>
		<FrozenAppHostIcon>$(MSBuildProjectDirectory)\$(ApplicationIcon)</FrozenAppHostIcon>
		<!-- The sha256 of the icon the frozen launcher was generated with. Moving the icon means
		     generating and committing a new apphost, so this is pinned rather than read. -->
		<FrozenAppHostIconSha256>193a8d1a11345b22ad213954ae5dc860c6bf381c3a7df4cbe3f21c1191ec2dac</FrozenAppHostIconSha256>
	</PropertyGroup>

	<Target Name="CheckFrozenAppHost">
		<Error Condition="!Exists('$(FrozenAppHost)')"
		       Text="The frozen launcher is missing: $(FrozenAppHost). See Resources\host\README.md; every release has to ship those exact bytes." />
		<Error Condition="!Exists('$(FrozenAppHostIcon)')"
		       Text="The application icon is missing: $(FrozenAppHostIcon). It is baked into the frozen launcher's bytes, so the build cannot tell whether what ships still matches it. See Resources\host\README.md." />
		<GetFileHash Files="$(FrozenAppHostIcon)" Algorithm="SHA256" HashEncoding="hex"
		             Condition="Exists('$(FrozenAppHostIcon)')">
			<Output TaskParameter="Hash" PropertyName="FrozenAppHostIconNow" />
		</GetFileHash>
		<Error Condition="Exists('$(FrozenAppHostIcon)') and '$(FrozenAppHostIconNow)' != '$(FrozenAppHostIconSha256)'"
		       Text="The application icon has changed: $(ApplicationIcon) is now sha256 $(FrozenAppHostIconNow), and the frozen launcher in Resources\host was generated with $(FrozenAppHostIconSha256). The icon lives INSIDE the launcher's bytes, not in the DLL, so freezing the launcher would keep shipping the old picture while every gate went green. The frozen host has to be rebuilt and re-frozen deliberately: generate a new apphost from the SDK, replace Resources\host\ValheimBakaLoader.exe with it, update FrozenAppHostTests.FrozenSha256 and FrozenAppHostIconSha256 here, and expect the first release carrying it to be a new hash in the world again. See Resources\host\README.md." />
		<Error Condition="'$(AssemblyName)' != 'ValheimBakaLoader'"
		       Text="The assembly name is now '$(AssemblyName)', and the frozen launcher in Resources\host has 'ValheimBakaLoader' baked into it, so it would look for a DLL that is not there. Generate a new apphost, replace that file, and update FrozenAppHostTests. See Resources\host\README.md." />
		<!-- The empty case is the outer cross-targeting build, which names no framework and
		     builds nothing. MSBuild runs a dependency even when the target that needs it is
		     skipped, so this has to let that one through or every build stops. -->
		<Error Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net6.0-windows'"
		       Text="The target framework is now '$(TargetFramework)', and the frozen launcher in Resources\host was generated for net6.0-windows. Generate a new apphost, replace that file, and update FrozenAppHostTests. See Resources\host\README.md." />
	</Target>

	<Target Name="FreezeAppHostIntermediate" AfterTargets="_CreateAppHost" DependsOnTargets="CheckFrozenAppHost"
	        Condition="'$(AppHostIntermediatePath)' != ''">
		<Copy SourceFiles="$(FrozenAppHost)" DestinationFiles="$(AppHostIntermediatePath)" />
	</Target>

	<Target Name="FreezeAppHost" AfterTargets="Build" DependsOnTargets="CheckFrozenAppHost"
	        Condition="'$(TargetFramework)' != ''">
		<Copy SourceFiles="$(FrozenAppHost)" DestinationFiles="$(OutDir)ValheimBakaLoader.exe" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\ValheimBakaLoader.Tools\ValheimBakaLoader.Tools.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DeviceId" Version="6.2.0" />
		<PackageReference Include="Humanizer" Version="2.14.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
		<PackageReference Include="Semver" Version="2.2.0" />
		<PackageReference Include="Serilog" Version="2.12.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
	</ItemGroup>

  <ItemGroup>
    <Compile Include="..\SolutionResources\ClientSecrets.cs" Link="Properties\ClientSecrets.cs" Condition="'$(Configuration)'=='Release' Or Exists('..\SolutionResources\ClientSecrets.cs')" />
    <Compile Include="..\SolutionResources\ClientSecrets.Values.cs" Link="Properties\ClientSecrets.Values.cs" Condition="'$(Configuration)'=='Release' Or Exists('..\SolutionResources\ClientSecrets.Values.cs')" />
  </ItemGroup>

	<!--
	  Bundled fallback item catalog + companion item-indexer plugin DLL. The JSON ships as the
	  vanilla fallback that powers the "Spawn X at" picker until the live, mod-aware items.json is
	  produced on the server. The indexer DLL (built separately via BakaLoaderItemIndexer/build-plugin.bat)
	  is auto-installed into the server's BepInEx/plugins folder by ItemIndexerInstaller; it's optional,
	  so the wildcard simply copies nothing when it hasn't been built yet.
	-->
	<ItemGroup>
		<Content Include="Resources\vanilla-items.json" Condition="Exists('Resources\vanilla-items.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\ItemIndexer\**\*.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\SpawnHelper\BakaLoaderSpawnHelper.dll" Condition="Exists('Resources\SpawnHelper\BakaLoaderSpawnHelper.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\KillAll\BakaKillAll.dll" Condition="Exists('Resources\KillAll\BakaKillAll.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Commander\BakaLoaderCommander.dll" Condition="Exists('Resources\Commander\BakaLoaderCommander.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\MaxPlayers\BakaLoaderMaxPlayers.dll" Condition="Exists('Resources\MaxPlayers\BakaLoaderMaxPlayers.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Exclude the .cs source reference files from compilation -->
		<Compile Remove="Resources\SpawnHelper\BakaLoaderSpawnHelper.cs" />
		<None Include="Resources\SpawnHelper\BakaLoaderSpawnHelper.cs" />
		<Compile Remove="Resources\KillAll\BakaKillAll.cs" />
		<None Include="Resources\KillAll\BakaKillAll.cs" />
		<Compile Remove="Resources\Commander\BakaLoaderCommander.cs" />
		<None Include="Resources\Commander\BakaLoaderCommander.cs" />
		<Compile Remove="Resources\MaxPlayers\BakaLoaderMaxPlayers.cs" />
		<None Include="Resources\MaxPlayers\BakaLoaderMaxPlayers.cs" />
		<!-- The client companion. Its plugin half names Valheim types and is fenced on
		     VALHEIM_PLUGIN, so it is removed from this project the way every other plugin entry
		     point is; its PLAN half carries no game type and IS compiled in, which is what lets
		     the suite drive the stamp rule and the sweep with no game installed.
		     There is deliberately no Content Include for BakaLoaderUncheat.dll: it runs on a
		     CLIENT and must never be copied into the app's own payload, where the installer would
		     be looking at it beside the four plugins that do belong on a server. The release
		     script picks it up from this folder and zips it on its own. -->
		<Compile Remove="Resources\Uncheat\BakaLoaderUncheat.cs" />
		<None Include="Resources\Uncheat\BakaLoaderUncheat.cs" />
	</ItemGroup>

	<!--
	  Blend UI - the WebView2-hosted HTML/CSS/JS interface (design-mockups/blend.html is the
	  visual spec). Served to the WebView via SetVirtualHostNameToFolderMapping from the
	  WebUI output folder; fonts are bundled locally so the app never depends on Google Fonts.
	-->
	<ItemGroup>
		<Content Include="WebUI\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!--
		  The pseudo locale is a test fixture, not a language: every sentence wrapped in
		  brackets and padded a third longer, so a language switch that misses a surface
		  shows up on sight. It is driven from the mock preview and read by the suite out
		  of the source tree, and no host has any use for it, so it stays out of what
		  ships. The file itself stays in the repository.
		-->
		<Content Remove="WebUI\i18n\xx.json" />
		<!--
		  The English catalog a second time, inside the assembly. The page fetches the file
		  beside it; the sentences that never reach a page (the restart countdown a player
		  reads, the Discord post a community reads) are written on this side, where there is
		  no fetch and no browser. Tools\HostCatalog.cs reads them out of here, so one catalog
		  holds every sentence in the product and a translator is handed one document.
		-->
		<EmbeddedResource Include="WebUI\i18n\en.json" LogicalName="ValheimBakaLoader.WebUI.i18n.en.json" />
	</ItemGroup>

</Project>